# Copy to .env and fill in. Never share or commit .env.
TELEGRAM_BOT_TOKEN=

# Optional: only these Telegram user ids may use the bot (comma separated). Empty = anyone.
ALLOWED_USER_IDS=

# How often prices are checked (seconds) and cooldown for "move" alerts (hours)
CHECK_EVERY_SEC=60
MOVE_ALERT_COOLDOWN_H=6
